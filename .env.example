# คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit .env

# LLM (สมัครฟรีได้ที่ console.groq.com และ aistudio.google.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# agent
USE_MOCK_AGENT=true     # true = ตอบด้วย mock ตามสัญญา (ให้ P2 ทำหน้าเว็บได้ก่อน)
DEMO_MODE=false         # true = ใช้คำตอบที่บันทึกไว้แทนการเรียก LLM

# ระบบ — เปลี่ยนก่อน deploy จริง
# JWT_SECRET: ก่อน deploy ต้องเปลี่ยน (ยาว ≥ 32 ตัว) ไม่อย่างนั้น API ไม่ยอมเริ่ม · สร้างด้วย
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
DEMO_EMAIL=demo@example.com      # บัญชีเดโมที่สร้างให้ตอน API เริ่ม (สำหรับอาจารย์)
DEMO_PASSWORD=demo1234
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
